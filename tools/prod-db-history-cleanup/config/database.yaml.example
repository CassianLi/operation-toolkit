# 数据库连接配置示例
# 复制此文件为 database.yaml 并修改为实际配置

database:
  # 阿里云RDS连接信息
  host: "your-rds-endpoint.aliyuncs.com"
  port: 3306
  user: "cleanup_user"
  password: "your_secure_password"
  database: "your_database_name"
  charset: "utf8mb4"

  # 连接池配置
  pool:
    max_connections: 5
    min_connections: 1
    connection_timeout: 30
    read_timeout: 60
    write_timeout: 60

  # SSL配置（阿里云RDS推荐启用）
  ssl:
    enabled: true
    verify_cert: false
    ca_cert: null

  # 连接参数
  autocommit: false
  sql_mode: "STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO"

  # 性能优化参数
  performance:
    # 设置会话变量
    session_variables:
      sql_mode: "STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO"
      innodb_lock_wait_timeout: 50
      lock_wait_timeout: 50

    # 查询优化
    query_timeout: 300
    max_allowed_packet: 16777216  # 16MB
