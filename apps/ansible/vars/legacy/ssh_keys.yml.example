---
# SSH密钥配置模板
# 复制此文件为 ssh_keys.yml 并填入实际的SSH公钥
# 注意：ssh_keys.yml 文件包含敏感信息，不应提交到版本控制

# SSH密钥配置说明
# 1. 复制此文件：cp ssh_keys.yml.example ssh_keys.yml
# 2. 编辑 ssh_keys.yml 文件，填入实际的SSH公钥
# 3. 确保 ssh_keys.yml 在 .gitignore 中被忽略

# Root权限用户SSH密钥配置
root_user_ssh_keys:
  # 管理员用户1的SSH密钥
  admin_user1:
    keys:
      - "ssh-rsa AAAA...REPLACE_ME... admin1@example.com"
      - "ssh-ed25519 AAAA...REPLACE_ME admin1@example.com"
    description: "管理员用户1的SSH公钥"

  # 管理员用户2的SSH密钥
  admin_user2:
    keys:
      - "ssh-rsa AAAA...REPLACE_ME... admin2@example.com"
    description: "管理员用户2的SSH公钥"

  # Root管理员的SSH密钥
  root_admin:
    keys:
      - "ssh-rsa AAAA...REPLACE_ME... root_admin@example.com"
      - "ssh-ed25519 AAAA...REPLACE_ME root_admin@example.com"
    description: "Root管理员的SSH公钥"

# SSH密钥生成说明
ssh_key_generation:
  # RSA密钥生成
  rsa_key:
    command: "ssh-keygen -t rsa -b 4096 -C 'your_email@example.com'"
    description: "生成4096位RSA密钥对"

  # ED25519密钥生成
  ed25519_key:
    command: "ssh-keygen -t ed25519 -C 'your_email@example.com'"
    description: "生成ED25519密钥对（推荐）"

  # 密钥文件位置
  key_locations:
    private_key: "~/.ssh/id_rsa 或 ~/.ssh/id_ed25519"
    public_key: "~/.ssh/id_rsa.pub 或 ~/.ssh/id_ed25519.pub"

# SSH密钥安全说明
ssh_security_notes:
  - "私钥文件权限应设置为 600"
  - "公钥文件权限应设置为 644"
  - "SSH目录权限应设置为 700"
  - "authorized_keys文件权限应设置为 600"
  - "定期轮换SSH密钥"
  - "使用强密码保护私钥"
  - "备份私钥到安全位置"

# 密钥验证命令
ssh_key_verification:
  # 验证公钥格式
  verify_public_key: "ssh-keygen -l -f ~/.ssh/id_rsa.pub"

  # 测试SSH连接
  test_connection: "ssh -i ~/.ssh/id_rsa user@server"

  # 查看SSH密钥指纹
  show_fingerprint: "ssh-keygen -lf ~/.ssh/id_rsa.pub"
