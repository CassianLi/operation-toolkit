# Docker Compose 通用权限管理环境变量配置
# 复制此文件为 .env 并修改相应的值

# ===========================================
# 宿主机用户信息配置 (必须配置)
# ===========================================
# 获取方法: 在宿主机运行 'id' 命令
# 示例输出: uid=1001(deployer) gid=1002(developers) groups=1002(developers)
# 对应配置: HOST_USER_ID=1001, HOST_GROUP_ID=1002

HOST_USER_ID=1001                    # 宿主机用户ID (必须)
HOST_GROUP_ID=1002                   # 宿主机用户组ID (必须)
HOST_USER_NAME=deployer              # 宿主机用户名 (可选)
HOST_GROUP_NAME=developers           # 宿主机用户组名 (可选)

# ===========================================
# 服务配置 (根据实际需求修改)
# ===========================================
SERVICE_NAME=your-service            # 服务名称
SERVICE_PORT=8080                    # 宿主机端口
CONTAINER_PORT=80                    # 容器端口

# ===========================================
# 系统配置
# ===========================================
TZ=Asia/Shanghai                     # 时区设置

# ===========================================
# 服务特定配置 (根据实际需求修改)
# ===========================================
# 数据库服务示例
# DB_NAME=app_database
# DB_USER=app_user
# DB_PASSWORD=your_secure_password
# DB_ROOT_PASSWORD=your_secure_root_password

# Web服务示例
# WEB_ENV=production
# WEB_DEBUG=false
# WEB_SECRET_KEY=your_secret_key

# 缓存服务示例
# CACHE_PASSWORD=your_cache_password
# CACHE_MAXMEMORY=256mb

# ===========================================
# 目录配置 (可选)
# ===========================================
DATA_DIR=./data                      # 数据目录
LOGS_DIR=./logs                      # 日志目录
CONFIG_DIR=./config                  # 配置目录
BACKUPS_DIR=./backups                # 备份目录
TMP_DIR=./tmp                        # 临时目录

# ===========================================
# 网络配置 (可选)
# ===========================================
NETWORK_NAME=your-service-network    # 网络名称
NETWORK_DRIVER=bridge                # 网络驱动

# ===========================================
# 资源限制配置 (可选)
# ===========================================
MEMORY_LIMIT=512M                    # 内存限制
CPU_LIMIT=0.5                        # CPU限制
MEMORY_RESERVATION=256M              # 内存预留
CPU_RESERVATION=0.25                 # CPU预留
