# MySQL Docker Compose 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ===========================================
# 宿主机用户信息配置 (必须配置)
# ===========================================
# 获取方法: 在宿主机运行 'id' 命令
# 示例输出: uid=1001(deployer) gid=1002(developers) groups=1002(developers)
# 对应配置: HOST_USER_ID=1001, HOST_GROUP_ID=1002

HOST_USER_ID=1001                    # 宿主机用户ID (必须)
HOST_GROUP_ID=1002                   # 宿主机用户组ID (必须)
HOST_USER_NAME=deployer              # 宿主机用户名 (可选)
HOST_GROUP_NAME=developers           # 宿主机用户组名 (可选)

# ===========================================
# MySQL 服务配置
# ===========================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=app_database
MYSQL_USER=app_user
MYSQL_PASSWORD=your_secure_user_password_here

# ===========================================
# 端口配置
# ===========================================
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# ===========================================
# 系统配置
# ===========================================
TZ=Asia/Shanghai

# ===========================================
# MySQL 字符集配置
# ===========================================
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# ===========================================
# MySQL 性能配置 (可选)
# ===========================================
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=200
MYSQL_QUERY_CACHE_SIZE=32M

# ===========================================
# 目录配置 (可选)
# ===========================================
MYSQL_DATA_DIR=./data
MYSQL_LOGS_DIR=./logs
MYSQL_CONFIG_DIR=./config
MYSQL_BACKUPS_DIR=./backups
