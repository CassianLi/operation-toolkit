.DS_Store

# Local scratch (keep placeholders)
tmp/*
!tmp/**/.gitkeep

# Archives / logs
*.tar.gz
*.log

# Secrets / env
.env
.env.*
!.env.example
*.pem
*.key

# Ansible local inventory & sensitive vars
**/inventory/hosts.yml
**/vars/simple_users.yml
**/vars/legacy/users.yml
**/vars/legacy/root_users.yml
**/vars/legacy/groups.yml
**/vars/legacy/ssh_keys.yml
**/vars/ssh_keys.yml
**/vars/users.yml
**/vars/root_users.yml
**/vars/groups.yml

# DB tool local config / runtime
**/config/database.yaml
apps/tools/**/backups/
apps/tools/**/logs/

# Python / IDE
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
*.swp
*~
